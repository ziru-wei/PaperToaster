{
  "manifest_version": 3,
  "name": "PDF AI Inspector",
  "version": "0.1.0",
  "description": "Minimal side-panel prototype for inspecting the active PDF and selected text.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "tabs",
    "unlimitedStorage",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "PDF AI Inspector"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/selection-listener.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/pdfjs/pdf.worker.mjs"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
