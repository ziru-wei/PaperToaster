{
  "manifest_version": 3,
  "name": "Paper Toaster",
  "version": "0.1.0",
  "description": "Side-panel reading companion for paper context, notes, and local conversations.",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "src/assets/extension/icon-16.png",
    "32": "src/assets/extension/icon-32.png",
    "48": "src/assets/extension/icon-48.png",
    "128": "src/assets/extension/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "tabs",
    "unlimitedStorage",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Paper Toaster",
    "default_icon": {
      "16": "src/assets/extension/icon-16.png",
      "32": "src/assets/extension/icon-32.png",
      "48": "src/assets/extension/icon-48.png",
      "128": "src/assets/extension/icon-128.png"
    }
  },
  "commands": {
    "open-dashboard": {
      "suggested_key": {
        "default": "Ctrl+E",
        "mac": "Command+E"
      },
      "description": "Open the Paper Toaster dashboard"
    },
    "_execute_side_panel": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Toggle the Paper Toaster side panel"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/selection-listener.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/pdfjs/pdf.worker.mjs"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
