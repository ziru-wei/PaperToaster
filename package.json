{
  "type": "module",
  "scripts": {
    "build:pdf2md": "esbuild node_modules/@pdf2md/core/dist/index.js --bundle --format=esm --platform=browser --outfile=vendor/pdf2md/pdf2md.mjs && mkdir -p vendor/pdf2md/pdfjs-dist/build && cp node_modules/@pdf2md/core/node_modules/pdfjs-dist/build/pdf.worker.min.mjs vendor/pdf2md/pdfjs-dist/build/pdf.worker.min.mjs",
    "build:markdown": "esbuild src/vendor/markdown-renderer-entry.js --bundle --format=esm --platform=browser --outfile=vendor/markdown-renderer/markdown-renderer.mjs",
    "build:vendors": "npm run build:pdf2md && npm run build:markdown"
  },
  "dependencies": {
    "@pdf2md/core": "^0.3.0",
    "dompurify": "^3.4.14",
    "esbuild": "^0.28.2",
    "markdown-it": "^15.0.1",
    "pdfjs-dist": "^6.3.289"
  }
}
